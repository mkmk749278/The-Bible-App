<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 3AM / Crisis Mode -->
    <string name="crisis_title">You are not alone</string>
    <string name="crisis_back">Back</string>
    <string name="crisis_tool_entry">I\'m not okay right now</string>
    <string name="crisis_menu_entry">I\'m not okay</string>
    <string name="crisis_heading">God sees you right now.</string>
    <string name="crisis_reassurance">Whatever you are carrying tonight, you don\'t have to carry it alone. Breathe. Rest here for a moment.</string>
    <string name="crisis_listen">Just listen</string>
    <string name="crisis_prayer_title">A prayer when you have no words</string>
    <string name="crisis_prayer_body">Lord, I am weary and afraid. Be near to me now. Quiet my heart, hold me through this night, and remind me that I am Yours. Amen.</string>

    <!-- Persecution-Aware Comfort (F-06) -->
    <string name="crisis_persecution_heading">I am facing persecution</string>
    <string name="crisis_persecution_subheading">Choose what you are facing for Scripture that speaks to it.</string>
    <string name="crisis_persecution_family">Family pressure</string>
    <string name="crisis_persecution_livelihood">Job or livelihood</string>
    <string name="crisis_persecution_danger">Physical danger</string>
    <string name="crisis_persecution_exclusion">Social exclusion</string>
    <string name="crisis_persecution_faith">Faith under doubt</string>

    <!-- Crisis AI Companion (F-03) -->
    <string name="crisis_ai_placeholder">Tell me what\'s happening…</string>
    <string name="crisis_ai_offline_hint">AI response needs internet. The verses below work offline.</string>
    <string name="crisis_ai_submit">Send</string>
    <string name="crisis_ai_thinking">Finding a passage for you…</string>

    <!-- Talk to someone now: human help is always one tap away in Crisis Mode. -->
    <string name="crisis_helpline_title">Talk to someone now</string>
    <string name="crisis_helpline_body">If you are thinking of ending your life, or you are in danger, please call. A real person will answer.</string>
    <string name="crisis_helpline_telemanas">Tele-MANAS · 14416</string>
    <string name="crisis_helpline_telemanas_detail">Free, 24 hours, in your language</string>
    <string name="crisis_helpline_emergency">Emergency · 112</string>
    <string name="crisis_helpline_call_telemanas">Call Tele-MANAS on 14416</string>
    <string name="crisis_helpline_call_emergency">Call emergency services on 112</string>
    <string name="crisis_ai_privacy_note">What you type is sent to Google Gemini to find a passage. It is not saved in Manna. Please don\'t include names.</string>
    <string name="crisis_ai_unavailable">I couldn\'t find a passage just now. The verses below are here for you.</string>
</resources>
